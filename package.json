{
  "name": "teamcook",
  "version": "0.1.0",
  "description": "AI 팀을 레시피로 요리하세요 — Codex·Claude Code 에이전트 팀을 설계하고 공유하는 도구",
  "type": "module",
  "homepage": "https://teamcook-eta.vercel.app/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fun5307/teamcook.git"
  },
  "keywords": [
    "claude-code",
    "codex",
    "multi-agent",
    "subagents",
    "agent-team",
    "recipes"
  ],
  "bin": {
    "teamcook": "cli/teamcook.mjs"
  },
  "files": [
    "cli/teamcook.mjs",
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "node scripts/vitest.mjs run",
    "test:watch": "node scripts/vitest.mjs",
    "typecheck": "tsc -b",
    "build:cli": "vite build --config vite.cli.config.ts",
    "open": "node cli/teamcook.mjs open",
    "prepublishOnly": "npm run typecheck && npm test && npm run build && npm run build:cli"
  },
  "devDependencies": {
    "@fontsource-variable/hahmlet": "^5.3.0",
    "@fontsource/ibm-plex-sans-kr": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@xyflow/react": "^12.12.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "jszip": "^3.10.2",
    "lucide-react": "^1.73.0",
    "lz-string": "^1.5.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.0",
    "smol-toml": "^1.9.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1",
    "zustand": "^5.1.0"
  }
}
